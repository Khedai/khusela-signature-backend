PORT=3000
# ── Where the data lives ─────────────────────────────────────────────────────
# Two modes, chosen by whether the first value below is set.
#
# EMPTY (the default): a local SQLite file at STORAGE_DIR/khusela.db. That is all
# tests and local development need — no account, no network.
#
# SET: the database lives at Turso, a free hosted SQLite (5 GB, no card required).
# It then holds the uploaded documents and the signature images too, as BLOB
# columns, and the server writes nothing to the host's disk. That is what lets it
# run on a free instance whose filesystem is wiped on every deploy. Both values come
# from the Turso CLI. Careful: there is NO npm package for it
# (`npm i -g @tursodatabase/cli` returns a 404) and it is Linux/macOS only, so on
# Windows it goes inside WSL. macOS: brew install tursodatabase/tap/turso.
# Linux and WSL: curl -sSfL https://get.tur.so/install.sh | bash
# The Turso dashboard does the same three things by clicking, with no install.
#   turso db create khusela
#   turso db show khusela --url      -> TURSO_DATABASE_URL
#   turso db tokens create khusela   -> TURSO_AUTH_TOKEN
#TURSO_DATABASE_URL=libsql://khusela-yourname.turso.io
#TURSO_AUTH_TOKEN=

# Folder used only by the local-file mode above (it has to be writable).
STORAGE_DIR=./storage

# The address the CLIENT'S OWN PHONE must be able to open. Every signing link is
# built from it, so it must be the public HTTPS URL your host gives you.
# Left empty the server falls back to http://localhost:3000 and warns at startup.
# On Render you can leave this empty: the server picks up Render's own
# RENDER_EXTERNAL_URL automatically. Set it only for a custom domain.
PUBLIC_BASE_URL=https://your-domain.co.za
TOKEN_EXPIRY_DAYS=7
MAX_UPLOAD_MB=15
# Comma-separated list of the exact sites allowed to call the API. The Khusela
# ITC PWA calls /api/invite and /api/manage/*, so its address must be listed
# (e.g. https://itc-extractor.vercel.app). '*' allows any site — avoid in production.
ALLOWED_ORIGINS=https://your-domain.co.za
# false (default): a signing link can be completed with a signature only, which
# is what the ITC application's "Send Signing Link" asks for.
# true: restore the original rule — documents must be uploaded before signing.
REQUIRE_DOCUMENTS=false

# ── Who may mint a signing link ──────────────────────────────────────────────
# POST /api/invite is the only route with no token to check: the consultant's app
# calls it straight from the browser. Set INVITE_API_KEY to a long random secret
# (the same command as ADMIN_API_KEY below) and every caller must then send it as
#   x-invite-key: <the key>          (or  Authorization: Bearer <the key>)
# The app has to be changed to send it first, or its "Send Signing Link" button
# stops working with a 401 — so this is commented out until the PWA sends it.
# While it is unset, the route accepts only callers that look like that app (an
# Origin in ALLOWED_ORIGINS, or this server's own address) or requests from this
# machine (the suites and local tools). An Origin header can be forged, so that is
# a floor: the key is the lock. /health reports the state as inviteProtected.
#INVITE_API_KEY=

# Minting a link writes a database row, so the route is rate limited per address:
# 20 requests per 10 minutes by default. 0 switches the limit off. The counters are
# held in this process, so a restart or a redeploy forgets them.
INVITE_RATE_LIMIT=20
INVITE_RATE_WINDOW_MS=600000

# How many reverse proxies append to X-Forwarded-For before this server sees the
# request. Too few and the IP stored with a signature is an address inside the host
# (on Render, with none trusted, it was "::1", which identifies nobody); too many and
# a caller could name itself in the header. Measured on Render on 2026-09-29 from a
# real signing request, the chain was
#   165.0.11.224, 172.68.247.29, 10.24.207.248
# — the client, Render's edge, Render's internal hop — which is why a service that
# says it is Render (it publishes RENDER_SERVICE_ID and RENDER_EXTERNAL_URL) uses 3
# without being told, and why render.yaml names 3 as well. Anywhere else the default
# is 1, which is the safe direction to be wrong in. Set it here to override: 1 for a
# single Nginx/Cloudflare hop, 0 only when this server is exposed directly to the
# internet, where X-Forwarded-For is written by the caller.
#TRUST_PROXY_HOPS=

ADMIN_API_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# ── Emailing the finished application ────────────────────────────────────────
# POST /api/email takes the PDF the PWA renders and mails it to MAIL_TO. It exists
# because the app used to hand that PDF to FormSubmit, a free third-party
# form-to-email service, which on 2026-09-30 answered every submission with a 500
# while the app reported success. See mailer.js for the full story.
#
# Leave these unset and nothing breaks: the route answers 503
# "email_not_configured", /health reports emailConfigured:false, and the app falls
# back to the old path. Set them and applications are delivered from your own
# mailbox instead, with the app showing the real outcome.
#
# MAIL_TO is the office mailbox, and it is the ONLY recipient this service will
# ever use: the app cannot name one (that is what stops a copied URL from being
# used to mail strangers). A comma-separated list works.
#MAIL_TO=khuselamanagement@gmail.com
#
# Gmail over SMTP needs an APP PASSWORD, not the account password: Google refuses
# the account password for SMTP. Turn on 2-step verification first, then create one
# at  myaccount.google.com > Security > App passwords  and paste the 16 characters
# here with no spaces.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=465
#SMTP_USER=khuselamanagement@gmail.com
#SMTP_PASS=the-16-character-app-password
#
# The sender. Gmail rewrites it to the authenticated account unless it is a
# verified "send as" alias, so leaving it empty (the default) is right. The subject
# the office filters on defaults to "Khusela Credit Application - ITC report" and
# the applicant's name is appended to it.
#MAIL_FROM=
#MAIL_SUBJECT=Khusela Credit Application - ITC report
#
# The most this service will send in one email, and the same ceiling the route
# accepts. Gmail refuses a message over 25 MB including its own encoding overhead,
# so 20 leaves room. The PWA's own limit is 20 MB against this route.
#MAX_EMAIL_MB=20
#
# EMAIL_API_KEY is the same idea as INVITE_API_KEY: set it to a long random secret
# (the command is beside ADMIN_API_KEY above) and every caller must send
#   x-email-key: <the key>          (or  Authorization: Bearer <the key>)
# The app has to be changed to send it first, so it is commented out until it does.
# While it is unset, /health reports emailProtected:false and only a caller with an
# allowed Origin, or one from this machine, is accepted.
#EMAIL_API_KEY=
#
# Emailing an application is a few MB and a real message to a real mailbox, so it
# is rate limited per address: 20 per 10 minutes by default, 0 switches it off.
#EMAIL_RATE_LIMIT=20
#EMAIL_RATE_WINDOW_MS=600000
