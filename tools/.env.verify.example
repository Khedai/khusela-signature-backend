# Copy this file to .env.verify in the PROJECT ROOT (one level up from tools/),
# fill in the values, then run: node tools/verify_vicidial.js
#
# .env.verify is gitignored. Never paste these values into chat.

# Origin only — no /vicidial suffix, no trailing slash.
VICIDIAL_BASE_URL=https://companyname.dialer.co.za
VICIDIAL_API_PATH=/vicidial/non_agent_api.php

# Your admin login can be used here IF it has API Access, View Reports and
# user_level 7+ in Admin -> Users. A dedicated API user works too.
VICIDIAL_API_USER=your_admin_login
VICIDIAL_API_PASS=your_password

# A consultant's Vicidial USER ID (not their password) from the pilot group,
# and a date when they definitely took a recorded call.
VICIDIAL_AGENT=1001
VICIDIAL_DATE=2026-11-19
